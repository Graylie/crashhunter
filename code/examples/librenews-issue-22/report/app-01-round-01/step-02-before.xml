dget.TextView" package="app.librenews.io.librenews" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,231][1038,426]" drawing-order="1" hint="" /><node index="1" text="Breaking news notifications are among the most important channels by which we receive information. LibreNews aims to democratize this medium by providing a minimalist, free, open source, fast, secure, and decentralized news notification service that will run on almost any phone." resource-id="app.librenews.io.librenews:id/textView2" class="android.widget.TextView" package="app.librenews.io.librenews" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,447][1038,749]" drawing-order="2" hint="" /><node index="2" text="LibreNews doesn't track you in any way, and doesn't have ads. It's completely open source, making the code free for anyone to see." resource-id="app.librenews.io.librenews:id/textView4" class="android.widget.TextView" package="app.librenews.io.librenews" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,770][1038,925]" drawing-order="4" hint="" /><node index="3" text="" resource-id="app.librenews.io.librenews:id/view2" class="android.view.View" package="app.librenews.io.librenews" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,946][1038,949]" drawing-order="5" hint="" /><node index="4" text="You'll mostly interact with LibreNews through its notifications, as the app itself is just settings. &#10;&#10;You'll probably get around 3 breaking news notifications per day, if you stick with the default settings." resource-id="app.librenews.io.librenews:id/textView3" class="android.widget.TextView" package="app.librenews.io.librenews" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,970][1038,1272]" drawing-order="3" hint="" /><node index="5" text="GO TO LIBRENEWS" resource-id="app.librenews.io.librenews:id/startLibreNews" class="android.widget.Button" package="app.librenews.io.librenews" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[312,2190][769,2316]" drawing-order="6" hint="" /></node></node></node></node></node></node><node index="1" text="" resource-id="android:id/statusBarBackground" class="android.view.View" package="app.librenews.io.librenews" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,63]" drawing-order="3" hint="" /><node index="2" text="" resource-id="android:id/navigationBarBackground" class="android.view.View" package="app.librenews.io.librenews" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2337][1080,2400]" drawing-order="2" hint="" /></node></hierarchy>